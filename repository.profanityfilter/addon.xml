<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.profanityfilter" name="Profanity Filter Repository" version="1.0.0" provider-name="Stefan Pretorius">
  <requires>
    <import addon="xbmc.addon" version="1.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Profanity Filter Repository">
    <dir>
      <info compressed="false">https://stefan-pretorius.github.io/ProfanityFilter/addons.xml</info>
      <checksum>https://stefan-pretorius.github.io/ProfanityFilter/addons.xml.md5</checksum>
      <datadir zip="true">https://stefan-pretorius.github.io/ProfanityFilter/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Repository for the Profanity Filter add-on</summary>
    <description>Provides automatic updates for the Profanity Filter Kodi add-on. Install this repository once, then updates appear in Kodi's add-on manager.</description>
  </extension>
</addon>
